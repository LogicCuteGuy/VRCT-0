{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCT-0",
  "version": "3.5.1-beta.4",
  "identifier": "com.vrct.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": false,
    "windows": [
      {
        "title": "VRCT-0",
        "center": true,
        "width": 450,
        "height": 220,
        "minWidth": 400,
        "minHeight": 200,
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "vrct-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "LogicCuteGuy",
    "copyright": "Copyright LogicCuteGuy and original VRCT contributors (m's software)",
    "licenseFile": "../LICENSE",
    "shortDescription": "VRCT-0 by LogicCuteGuy — VRChat translation and transcription",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/cpal/LICENSE": "licenses/cpal-LICENSE",
      "vendor/cpal/VRCT-PATCH.md": "licenses/cpal-VRCT-PATCH.md",
      "resources/openvr/openvr_api.dll": "openvr_api.dll",
      "resources/openvr/LICENSE": "licenses/openvr-LICENSE",
      "resources/transliteration": "resources/transliteration",
      "resources/fonts": "resources/fonts",
      "resources/ocr": "resources/ocr",
      "resources/onnxruntime/onnxruntime.dll": "onnxruntime.dll",
      "resources/onnxruntime/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "resources/onnxruntime/LICENSE": "licenses/onnxruntime-LICENSE",
      "resources/onnxruntime/ThirdPartyNotices.txt": "licenses/onnxruntime-ThirdPartyNotices.txt",
      "resources/msvc/msvcp140.dll": "msvcp140.dll",
      "resources/msvc/msvcp140_1.dll": "msvcp140_1.dll",
      "resources/msvc/vcruntime140.dll": "vcruntime140.dll",
      "resources/msvc/vcruntime140_1.dll": "vcruntime140_1.dll",
      "resources/msvc/manifest.json": "resources/msvc/manifest.json",
      "resources/msvc/NOTICE.md": "licenses/MSVC-NOTICE.md",
      "resources/msvc/Redist.txt": "licenses/MSVC-Redist.txt"
    },
    "windows": {
      "nsis": {
        "template": "nsis/template.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Thai",
          "Japanese",
          "Korean",
          "TradChinese",
          "SimpChinese"
        ]
      }
    }
  }
}
