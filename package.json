{
  "name": "vrct-0",
  "private": true,
  "version": "3.5.1-beta.2",
  "type": "module",
  "scripts": {
    "test:appearance": "node --test utils/tests/appearance.test.js",
    "tools:build": "node utils/native_env.js cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- tools",
    "tools:build-release": "node utils/native_env.js cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- tools --profile release",
    "tools:package": "cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- package-tools",
    "tools:package-release": "cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- package-tools --profile release",
    "native:prepare": "cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- prepare",
    "native:prepare-release": "cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- prepare --profile release",
    "native:verify": "cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- verify",
    "vite": "vite",
    "vite-build": "vite build",
    "vite-preview": "vite preview",
    "tauri": "tauri",
    "tauri-dev": "node utils/native_env.js npm run tauri-dev-native",
    "tauri-dev-native": "tauri dev --features ct2",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean-soft": "cargo clean --manifest-path src-tauri/Cargo.toml -p VRCT",
    "update-version": "cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- version",
    "dev": "node utils/native_env.js npm run dev-native",
    "dev-native": "npm run update-version && npm run native:prepare && npm run dev-ui",
    "dev-fast": "npm run dev",
    "dev-cuda": "npm run dev",
    "dev-cuda-fast": "npm run dev",
    "dev-ui": "npm-run-all --parallel vite tauri-dev",
    "analyze-error": "node utils/analyze_ui_error.js",
    "build": "node utils/native_env.js npm run build-native",
    "build-native": "npm run update-version && npm run native:prepare-release && npm run vite-build && tauri build --features ct2",
    "build-cuda": "npm run build",
    "release": "npm run build && cargo run --manifest-path src-tauri/Cargo.toml -p xtask -- package --profile release --output VRCT.zip"
  },
  "dependencies": {
    "@babel/standalone": "7.27.0",
    "@tauri-apps/api": "2.5.0",
    "@tauri-apps/plugin-fs": "2.2.1",
    "@tauri-apps/plugin-global-shortcut": "2.2.0",
    "@tauri-apps/plugin-http": "2.4.3",
    "@tauri-apps/plugin-opener": "2.2.6",
    "@tauri-apps/plugin-shell": "2.2.1",
    "clsx": "2.1.1",
    "i18next": "25.0.1",
    "jotai": "2.12.3",
    "js-base64": "3.7.7",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-colorful": "5.6.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "5.0.0",
    "react-i18next": "15.5.1",
    "react-resizable-layout": "0.7.2",
    "react-toastify": "11.0.5",
    "sass": "1.79.4",
    "semver": "7.7.1"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "4.1.2",
    "@tauri-apps/cli": "2.5.0",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.25.1",
    "eslint-plugin-react": "7.37.5",
    "npm-run-all": "4.1.5",
    "source-map": "0.7.4",
    "vite": "6.3.4",
    "vite-plugin-svgr": "4.3.0"
  }
}
